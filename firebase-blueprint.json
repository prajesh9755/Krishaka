{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered farmer or buyer user profile with credentials and trade details.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique user ID" },
        "phone": { "type": "string", "description": "Phone number" },
        "email": { "type": "string", "description": "Email address" },
        "name": { "type": "string", "description": "Full name" },
        "role": { "type": "string", "enum": ["farmer", "buyer"], "description": "Role of the user" },
        "language": { "type": "string", "description": "Preferred language code" },
        "createdAt": { "type": "string", "description": "Account creation timestamp" },
        "updatedAt": { "type": "string", "description": "Account last update timestamp" },
        "isVerified": { "type": "boolean", "description": "Verification status" },
        "farmerDetails": { "type": "object", "description": "Land, crops, kisan card details for farmer" },
        "buyerDetails": { "type": "object", "description": "Business, trade volume, GST details for buyer" }
      },
      "required": ["id", "phone", "name", "role", "createdAt"]
    },
    "CropListing": {
      "title": "CropListing",
      "description": "Produce lots listed for sale by farmers.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique listing identifier" },
        "farmerId": { "type": "string", "description": "ID of the farmer owner" },
        "farmerName": { "type": "string", "description": "Name of the farmer owner" },
        "farmerPhone": { "type": "string", "description": "Contact phone for the lot" },
        "cropName": { "type": "string", "description": "Name of the crop" },
        "variety": { "type": "string", "description": "Crop variety" },
        "category": { "type": "string", "description": "Produce category" },
        "quantityQuintals": { "type": "number", "description": "Available quantity in quintals" },
        "pricePerQuintal": { "type": "number", "description": "Expected price in INR per quintal" },
        "apmcMandiBenchmark": { "type": "number", "description": "APMC mandi benchmark rate" },
        "harvestDate": { "type": "string", "description": "Harvest or ready date" },
        "location": { "type": "string", "description": "Village or market location" },
        "organicCertified": { "type": "boolean", "description": "Whether organic certified" },
        "grade": { "type": "string", "description": "Quality grade A/B/C" },
        "status": { "type": "string", "enum": ["available", "booked", "sold"], "description": "Listing availability status" },
        "createdAt": { "type": "string", "description": "Listing creation timestamp" },
        "updatedAt": { "type": "string", "description": "Listing update timestamp" }
      },
      "required": ["id", "farmerId", "farmerName", "cropName", "quantityQuintals", "pricePerQuintal", "status"]
    },
    "Order": {
      "title": "Order",
      "description": "Deals, bids and purchase contracts between buyers and farmers.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique order ID" },
        "listingId": { "type": "string", "description": "ID of the associated crop lot" },
        "cropName": { "type": "string", "description": "Crop name" },
        "farmerId": { "type": "string", "description": "ID of farmer" },
        "farmerName": { "type": "string", "description": "Name of farmer" },
        "buyerId": { "type": "string", "description": "ID of buyer" },
        "buyerName": { "type": "string", "description": "Name of buyer" },
        "buyerPhone": { "type": "string", "description": "Buyer contact phone" },
        "quantityQuintals": { "type": "number", "description": "Order quantity in quintals" },
        "offeredPricePerQuintal": { "type": "number", "description": "Agreed price per quintal" },
        "totalAmount": { "type": "number", "description": "Total order amount in INR" },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected", "dispatched", "completed"], "description": "Order status" },
        "paymentStatus": { "type": "string", "enum": ["pending", "escrow", "paid"], "description": "Payment escrow status" },
        "deliveryLocation": { "type": "string", "description": "Delivery city or mandi address" },
        "createdAt": { "type": "string", "description": "Timestamp created" },
        "updatedAt": { "type": "string", "description": "Timestamp updated" }
      },
      "required": ["id", "listingId", "farmerId", "buyerId", "quantityQuintals", "offeredPricePerQuintal", "status"]
    },
    "MandiRate": {
      "title": "MandiRate",
      "description": "Live APMC mandi market benchmark rates.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique rate identifier" },
        "commodity": { "type": "string", "description": "Crop or produce commodity" },
        "market": { "type": "string", "description": "APMC market center" },
        "state": { "type": "string", "description": "State name" },
        "district": { "type": "string", "description": "District name" },
        "minPrice": { "type": "number", "description": "Minimum rate in INR/quintal" },
        "maxPrice": { "type": "number", "description": "Maximum rate in INR/quintal" },
        "modalPrice": { "type": "number", "description": "Modal rate in INR/quintal" },
        "trend": { "type": "string", "description": "Price trend: up/down/stable" },
        "lastUpdated": { "type": "string", "description": "ISO timestamp" }
      },
      "required": ["id", "commodity", "market", "modalPrice"]
    },
    "AgriWasteListing": {
      "title": "AgriWasteListing",
      "description": "Agricultural crop residue, husk, stubble and biomass lots for industrial procurement and monetization.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique waste listing identifier" },
        "farmerId": { "type": "string", "description": "ID of farmer" },
        "farmerName": { "type": "string", "description": "Name of farmer" },
        "farmerPhone": { "type": "string", "description": "Farmer contact phone" },
        "wasteType": { "type": "string", "description": "Type of crop biomass or stubble" },
        "quantityTons": { "type": "number", "description": "Volume available in metric tons" },
        "pricePerTon": { "type": "number", "description": "Price in INR per ton" },
        "location": { "type": "string", "description": "Village or pickup location" },
        "district": { "type": "string", "description": "District" },
        "moisturePercent": { "type": "number", "description": "Moisture percentage" },
        "suggestedUse": { "type": "string", "description": "Bio-Energy Pellet, Paper Pulp, Compost, etc." },
        "dateListed": { "type": "string", "description": "Date listed" },
        "status": { "type": "string", "description": "available, in-discussion, sold" },
        "imageUrl": { "type": "string", "description": "Photo of the biomass lot" }
      },
      "required": ["id", "farmerId", "wasteType", "quantityTons", "pricePerTon", "status"]
    },
    "GovtScheme": {
      "title": "GovtScheme",
      "description": "Central & State Government agricultural subsidy, DBT, and welfare schemes.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique scheme identifier" },
        "code": { "type": "string", "description": "Official abbreviation (e.g. PM-KISAN, PMFBY)" },
        "name": { "type": "string", "description": "Full scheme title" },
        "category": { "type": "string", "description": "Category: Direct Income Support, Crop Insurance, Solar & Irrigation, Credit & Loans, Organic Farming, Machinery Subsidy" },
        "benefitAmount": { "type": "string", "description": "Financial or subsidy quantum" },
        "description": { "type": "string", "description": "Scheme scope and objective" },
        "eligibility": { "type": "string", "description": "Eligibility conditions" },
        "portalLink": { "type": "string", "description": "Official government website link" },
        "maxSubsidyPercent": { "type": "number", "description": "Percentage subsidy provided if applicable" },
        "applicationStatus": { "type": "string", "description": "General status: Open for Application, Active, etc." },
        "requiredDocuments": { "type": "array", "description": "List of documents needed" }
      },
      "required": ["id", "code", "name", "category", "benefitAmount", "portalLink"]
    },
    "SchemeApplication": {
      "title": "SchemeApplication",
      "description": "Farmer direct applications, DBT tracking, and subsidy claim requests.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique application identifier" },
        "schemeId": { "type": "string", "description": "ID of the associated GovtScheme" },
        "schemeCode": { "type": "string", "description": "Code of the scheme" },
        "schemeName": { "type": "string", "description": "Title of the scheme" },
        "farmerId": { "type": "string", "description": "ID of applicant farmer" },
        "farmerName": { "type": "string", "description": "Name of applicant farmer" },
        "farmerPhone": { "type": "string", "description": "Contact number" },
        "kisanCardNumber": { "type": "string", "description": "Kisan Credit Card / Aadhaar identifier" },
        "bankUpiId": { "type": "string", "description": "Linked DBT bank account or UPI" },
        "landAreaAcres": { "type": "number", "description": "Cultivable land in acres" },
        "village": { "type": "string", "description": "Farmer village" },
        "district": { "type": "string", "description": "Farmer district" },
        "state": { "type": "string", "description": "Farmer state" },
        "status": { "type": "string", "enum": ["applied", "under_review", "sanctioned", "disbursed", "rejected"], "description": "Application status" },
        "referenceNumber": { "type": "string", "description": "Official tracking reference code" },
        "benefitAmount": { "type": "string", "description": "Subsidy or disbursement value" },
        "appliedDate": { "type": "string", "description": "Date applied" },
        "lastUpdated": { "type": "string", "description": "Last status change timestamp" },
        "notes": { "type": "string", "description": "Officer remarks or status details" }
      },
      "required": ["id", "schemeId", "farmerId", "farmerName", "status", "appliedDate"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles for farmers and buyers."
    },
    "/crop_listings/{listingId}": {
      "schema": "CropListing",
      "description": "Available agricultural produce lots listed by farmers."
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Purchase orders, contracts and bids placed by buyers."
    },
    "/mandi_rates/{rateId}": {
      "schema": "MandiRate",
      "description": "APMC mandi price benchmarks."
    },
    "/agri_waste_listings/{wasteId}": {
      "schema": "AgriWasteListing",
      "description": "Agricultural waste, biomass and stubble listings for bio-refineries, paper mills, and compost producers."
    },
    "/govt_schemes/{schemeId}": {
      "schema": "GovtScheme",
      "description": "Central & State Government agricultural subsidy, DBT, and welfare schemes."
    },
    "/scheme_applications/{applicationId}": {
      "schema": "SchemeApplication",
      "description": "Farmer scheme applications, DBT payouts, and status tracking."
    }
  }
}
